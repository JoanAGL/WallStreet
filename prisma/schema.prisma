generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvestmentHorizon {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks            Stock[]
  portfolioAnalysis PortfolioAnalysis?
  userProfile       UserProfile?
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskScore Int
  riskLabel String   // "Conservador" | "Moderado" | "Agresivo"
  answers   String   // JSON with original answers
  updatedAt DateTime @updatedAt
}

model PortfolioAnalysis {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJson String
  stockCount   Int
  updatedAt    DateTime @updatedAt
}

model Stock {
  id                String            @id @default(cuid())
  ticker            String
  userId            String
  investmentHorizon InvestmentHorizon @default(SHORT_TERM)
  purchasePrice     Float?
  purchaseDate      DateTime?
  quantity          Float?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  analysis          StockAnalysis?
  history           StockAnalysisHistory[]
  closedOperations  ClosedOperation[]
  transactions      Transaction[]

  @@unique([ticker, userId])
}

model ClosedOperation {
  id               String   @id @default(uuid())
  stockId          String
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  ticker           String
  shares           Float
  buyPrice         Float
  sellPrice        Float
  investedAmount   Float    // shares * buyPrice
  revenueAmount    Float    // shares * sellPrice
  profitAmount     Float    // revenueAmount - investedAmount
  profitPercentage Float    // (profitAmount / investedAmount) * 100
  closedAt         DateTime @default(now())

  @@index([stockId, closedAt(sort: Desc)])
}

model StockAnalysis {
  id                    String   @id @default(cuid())
  stockId               String   @unique
  stock                 Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  price                 Float
  changePercent         Float

  sma20                 Float?
  sma50                 Float?
  rsi14                 Float?

  newsSummary           String
  newsSentiment         String

  analysisText          String
  scenarioLabel         String
  scenarioJustification String
  divergenceAlert       Json?
  horizonMatch          String?
  keyMetrics            String?
  metricsData           String?
  allHorizons           String?

  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StockAnalysisHistory {
  id            String   @id @default(cuid())
  stockId       String
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  snapshotAt    DateTime @default(now())
  price         Float
  changePercent Float
  scenarioLabel String
  horizonUsed   String
  rsi14         Float?

  @@index([stockId, snapshotAt(sort: Desc)])
}

enum TransactionType {
  BUY
  SELL
}

model Transaction {
  id        String          @id @default(uuid())
  stockId   String
  stock     Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type      TransactionType
  shares    Float
  price     Float           // average price per share for this transaction
  date      DateTime?       // optional acquisition / sale date
  notes     String?         // optional free-text annotation
  createdAt DateTime        @default(now())

  @@index([stockId, createdAt(sort: Desc)])
}

// Shared persistent cache for cross-request data (macro context, earnings guidance).
// Replaces in-memory Map caches that reset on every Vercel serverless invocation.
model CacheEntry {
  key       String   @id        // e.g. "macro::global", "earnings::AAPL::Q2 2025"
  value     String              // JSON-serialized payload
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
