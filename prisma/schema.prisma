generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvestmentHorizon {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks    Stock[]
}

model Stock {
  id        String   @id @default(cuid())
  ticker            String
  userId            String
  investmentHorizon InvestmentHorizon @default(SHORT_TERM)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  analysis  StockAnalysis?
  history   StockAnalysisHistory[]

  @@unique([ticker, userId])
}

model StockAnalysis {
  id                    String   @id @default(cuid())
  stockId               String   @unique
  stock                 Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  price                 Float
  changePercent         Float

  sma20                 Float?
  sma50                 Float?
  rsi14                 Float?

  newsSummary           String
  newsSentiment         String

  analysisText          String
  scenarioLabel         String
  scenarioJustification String
  divergenceAlert       Boolean  @default(false)
  horizonMatch          String?
  keyMetrics            String?
  metricsData           String?
  allHorizons           String?

  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StockAnalysisHistory {
  id            String   @id @default(cuid())
  stockId       String
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  snapshotAt    DateTime @default(now())
  price         Float
  changePercent Float
  scenarioLabel String
  horizonUsed   String
  rsi14         Float?

  @@index([stockId, snapshotAt(sort: Desc)])
}
