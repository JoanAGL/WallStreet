generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvestmentHorizon {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks             Stock[]
  portfolioAnalysis  PortfolioAnalysis?
  userProfile        UserProfile?
  manualSellEntries  ManualSellEntry[]
  portfolioSnapshots PortfolioSnapshot[]
}

// Snapshot diario del valor de cartera (equity curve + TWR)
model PortfolioSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime // normalizada a las 00:00 UTC del día
  totalValue Float    // valor de mercado USD de las posiciones abiertas
  costBasis  Float    // coste base WAC USD de las posiciones abiertas
  netFlows   Float    @default(0) // compras − ventas (USD) del día, para el TWR
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskScore Int
  riskLabel String   // "Conservador" | "Moderado" | "Agresivo"
  answers   String   // JSON with original answers
  updatedAt DateTime @updatedAt
}

model PortfolioAnalysis {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJson String
  stockCount   Int
  updatedAt    DateTime @updatedAt
}

model Stock {
  id                String            @id @default(cuid())
  ticker            String
  userId            String
  isin              String?
  name              String?
  sector            String?
  investmentHorizon InvestmentHorizon @default(SHORT_TERM)
  purchasePrice     Float?
  purchaseDate      DateTime?
  quantity          Float?
  currency          String            @default("USD")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  analysis          StockAnalysis?
  history           StockAnalysisHistory[]
  closedOperations  ClosedOperation[]
  transactions      Transaction[]

  @@unique([ticker, userId])
}

model ClosedOperation {
  id               String   @id @default(uuid())
  stockId          String
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  ticker           String
  shares           Float
  buyPrice         Float
  sellPrice        Float
  investedAmount   Float    // shares * buyPrice
  revenueAmount    Float    // shares * sellPrice
  profitAmount     Float    // revenueAmount - investedAmount
  profitPercentage Float    // (profitAmount / investedAmount) * 100
  closedAt         DateTime @default(now())

  @@index([stockId, closedAt(sort: Desc)])
}

model StockAnalysis {
  id                    String   @id @default(cuid())
  stockId               String   @unique
  stock                 Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  price                 Float
  priceUSD              Float?
  currency              String   @default("USD")
  changePercent         Float

  sma20                 Float?
  sma50                 Float?
  rsi14                 Float?
  marketRegime          String?  // CombinedMarketRegime (issue #49): TRENDING_BULL | ... | VOLATILITY_CRUSH

  newsSummary           String
  newsSentiment         String

  analysisText          String
  scenarioLabel         String
  scenarioJustification String
  divergenceAlert       Json?
  horizonMatch          String?
  keyMetrics            String?
  metricsData           String?
  allHorizons           String?

  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StockAnalysisHistory {
  id            String   @id @default(cuid())
  stockId       String
  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  snapshotAt    DateTime @default(now())
  price         Float
  changePercent Float
  scenarioLabel String
  horizonUsed   String
  rsi14         Float?

  @@index([stockId, snapshotAt(sort: Desc)])
}

enum TransactionType {
  BUY
  SELL
  SPLIT
  DIVIDEND
}

model Transaction {
  id        String          @id @default(uuid())
  stockId   String
  stock     Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type      TransactionType
  shares    Float
  price     Float           // average price per share for this transaction
  fee       Float           @default(0) // commission (BUY/SELL) or withholding (DIVIDEND), USD
  date      DateTime?       // optional acquisition / sale date
  notes     String?         // optional free-text annotation
  createdAt DateTime        @default(now())

  @@index([stockId, createdAt(sort: Desc)])
}

// Manual sell entries — historical positions not tracked in the dashboard.
model ManualSellEntry {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker           String
  shares           Float
  avgBuyPrice      Float
  sellPrice        Float
  investedAmount   Float
  revenueAmount    Float
  profitAmount     Float
  profitPercentage Float
  date             DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())

  @@index([userId, date(sort: Desc)])
}

// Shared persistent cache for cross-request data (macro context, earnings guidance).
// Replaces in-memory Map caches that reset on every Vercel serverless invocation.
model CacheEntry {
  key       String   @id        // e.g. "macro::global", "earnings::AAPL::Q2 2025"
  value     String              // JSON-serialized payload
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
